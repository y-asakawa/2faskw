[Unit]
Description=2FAS-KW Standalone Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=2faskw-dashboard
Group=2faskw-dashboard
ExecStart=/opt/2faskw-dashboard/bin/2faskw-dashboard.sh server
Restart=on-failure
RestartSec=5s
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/2faskw-dashboard
MemoryMax=768M
CPUQuota=100%
TasksMax=256
LimitCORE=0

[Install]
WantedBy=multi-user.target
